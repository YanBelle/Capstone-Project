version: '3.8'

# DEVELOPMENT ENVIRONMENT
# Ports used to avoid conflict with production:
# - API: 8001 (prod: 8000)
# - Dashboard: 3000 (prod: 80 via nginx)
# - PostgreSQL: 5434 (prod: 5433)
# - Redis: 6380 (prod: 6379)
# - Jupyter: 8889 (prod: 8888)
# - Grafana: 3002 (prod: 3001)
# - Prometheus: 9091 (prod: 9090)

services:
  # ML-First anomaly detection service - DEV
  anomaly-detector:
    build: ./services/anomaly-detector
    container_name: abm-ml-anomaly-detector-dev
    environment:
      - PYTHONUNBUFFERED=1
      - LOG_LEVEL=DEBUG
      - MODEL_UPDATE_INTERVAL=30
      - ANOMALY_THRESHOLD=0.5
      - REDIS_HOST=redis
      - REDIS_PASSWORD=dev-redis-pass
      - POSTGRES_HOST=postgres
      - POSTGRES_DB=abmdb_dev
      - POSTGRES_USER=abmuser
      - POSTGRES_PASSWORD=abmpass123
      - BERT_MODEL=bert-base-uncased
      - TRANSFORMERS_CACHE=/app/cache
    volumes:
      - ./data/models:/app/models
      - ./data/input:/app/input
      - ./data/output:/app/output
      - ./data/sessions:/app/data/sessions
      - transformer-cache-dev:/app/cache
      - /var/log/abm-ml-anomaly-detector-dev:/app/logs
    depends_on:
      - postgres
      - redis
    restart: unless-stopped
    networks:
      - abm_network_dev

  # PostgreSQL Database - DEV
  postgres:
    image: postgres:15
    container_name: postgres_dev
    environment:
      POSTGRES_DB: abmdb_dev
      POSTGRES_USER: abmuser
      POSTGRES_PASSWORD: abmpass123
      POSTGRES_HOST_AUTH_METHOD: trust
    ports:
      - "5434:5432"  # DEV: 5434 (PROD: 5433)
    volumes:
      - postgres_data_dev:/var/lib/postgresql/data
      - ./init-db:/docker-entrypoint-initdb.d
    networks:
      - abm_network_dev

  # Redis Cache - DEV
  redis:
    image: redis:7-alpine
    container_name: redis_dev
    ports:
      - "6380:6379"  # DEV: 6380 (PROD: 6379)
    command: redis-server --requirepass dev-redis-pass
    volumes:
      - redis_data_dev:/data
    networks:
      - abm_network_dev

  # API service - DEV
  api:
    build:
      context: ./services/api
      dockerfile: Dockerfile
    container_name: api_dev
    ports:
      - "8001:8000"  # DEV: 8001 (PROD: 8000)
    environment:
      - PYTHONUNBUFFERED=1
      - REDIS_HOST=redis
      - REDIS_PASSWORD=dev-redis-pass
      - POSTGRES_HOST=postgres
      - POSTGRES_DB=abmdb_dev
      - POSTGRES_USER=abmuser
      - POSTGRES_PASSWORD=abmpass123
      - BERT_MODEL=bert-base-uncased
      - TRANSFORMERS_CACHE=/app/cache
      - SECRET_KEY=dev-secret-key-change-in-production
      - ENVIRONMENT=development
      - DATABASE_URL=postgresql://abmuser:abmpass123@postgres:5432/abmdb_dev
    volumes:
      - ./data/models:/app/models
      - ./data/input:/app/input
      - ./data/output:/app/output
      - ./data/sessions:/app/data/sessions
      - transformer-cache-dev:/app/cache
      - /var/log/abm-ml-api-dev:/app/logs
    depends_on:
      - postgres
      - redis
    networks:
      - abm_network_dev
    restart: unless-stopped

  # Dashboard service - DEV
  dashboard:
    build:
      context: ./services/dashboard
      dockerfile: Dockerfile
      args:
        REACT_APP_API_URL: http://64.227.16.180:8001
    container_name: dashboard_dev
    ports:
      - "3000:80"  # DEV: 3000 (PROD: via nginx on port 80)
    environment:
      - REACT_APP_API_URL=http://64.227.16.180:8001
      - ENVIRONMENT=development
    depends_on:
      - api
    networks:
      - abm_network_dev
    restart: unless-stopped

  # Jupyter Notebook - DEV
  jupyter:
    build: ./services/jupyter
    container_name: jupyter_dev
    ports:
      - "8889:8888"  # DEV: 8889 (PROD: 8888)
    environment:
      - JUPYTER_ENABLE_LAB=yes
      - JUPYTER_TOKEN=dev-token
    volumes:
      - ./notebooks:/home/jovyan/work
      - ./data:/home/jovyan/data
      - ./services:/home/jovyan/services
    restart: unless-stopped
    networks:
      - abm_network_dev

  # Grafana - DEV
  grafana:
    image: grafana/grafana:latest
    container_name: grafana_dev
    ports:
      - "3002:3000"  # DEV: 3002 (PROD: 3001)
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=dev-admin
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - grafana_data_dev:/var/lib/grafana
    restart: unless-stopped
    networks:
      - abm_network_dev

  # Prometheus - DEV
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus_dev
    ports:
      - "9091:9090"  # DEV: 9091 (PROD: 9090)
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
    volumes:
      - prometheus_data_dev:/prometheus
    restart: unless-stopped
    networks:
      - abm_network_dev

networks:
  abm_network_dev:
    driver: bridge

volumes:
  postgres_data_dev:
  redis_data_dev:
  grafana_data_dev:
  prometheus_data_dev:
  transformer-cache-dev:
